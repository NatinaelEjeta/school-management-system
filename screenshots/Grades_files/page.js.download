c.setTextColor(255, 255, 255);\n    doc.setFont('helvetica', 'bold');\n    doc.setFontSize(19);\n    doc.text('Nejo preparatory School Academy', 14, 14);\n    doc.setFont('helvetica', 'normal');\n    doc.setFontSize(11);\n    doc.text('Student Report Card', 14, 21);\n    doc.setFontSize(9);\n    doc.text(`Generated ${formatGenerated(report.generatedAt)}`, pageWidth - 14, 21, {\n        align: 'right'\n    });\n    // ---- Student summary ----\n    const student = report.student;\n    const overall = report.overallAveragePercent === null ? '—' : `${report.overallAveragePercent.toFixed(1)}%`;\n    const attendanceRate = `${report.attendance.rate.toFixed(1)}%`;\n    doc.setTextColor(30, 30, 30);\n    doc.setFont('helvetica', 'bold');\n    doc.setFontSize(12);\n    doc.text(student.name, 14, 42);\n    doc.setFont('helvetica', 'normal');\n    doc.setFontSize(9);\n    doc.setTextColor(90, 90, 90);\n    doc.text(`Email: ${student.email}`, 14, 48);\n    doc.text(`Grade level: ${student.gradeLevel}`, 14, 53);\n    doc.text(`Date of birth: ${(0,_shared__WEBPACK_IMPORTED_MODULE_0__.formatDate)(student.dateOfBirth)}`, 14, 58);\n    doc.setTextColor(90, 90, 90);\n    doc.text('Overall average:', pageWidth - 90, 48, {\n        align: 'right'\n    });\n    doc.text('Attendance rate:', pageWidth - 90, 53, {\n        align: 'right'\n    });\n    doc.text('Courses enrolled:', pageWidth - 90, 58, {\n        align: 'right'\n    });\n    doc.setTextColor(20, 20, 20);\n    doc.setFont('helvetica', 'bold');\n    doc.text(overall, pageWidth - 14, 48, {\n        align: 'right'\n    });\n    doc.text(attendanceRate, pageWidth - 14, 53, {\n        align: 'right'\n    });\n    doc.text(`${report.courses.length}`, pageWidth - 14, 58, {\n        align: 'right'\n    });\n    doc.setFont('helvetica', 'normal');\n    // ---- Course summary table ----\n    const summaryRows = report.courses.map((course)=>[\n            course.courseName,\n            course.teacherName ?? 'Unassigned',\n            